<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="24dp"
    tools:context=".AddWordActivity">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="25dp"
        android:orientation="vertical">

        <!--  header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView7"
                android:layout_width="36dp"
                android:layout_height="47dp"
                android:layout_marginLeft="-2dp"
                app:srcCompat="@drawable/screenshot_2025_11_07_140118" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="70dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="17dp"
                android:fontFamily="@font/poppins_extrabold"
                android:text="Add New Word"
                android:textColor="#4F1F7A"
                android:textSize="25sp" />

        </LinearLayout>

        <!-- list -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="155dp"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Select Set"
            android:textSize="18sp" />

        <Spinner
            android:id="@+id/listDropdown"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/rounded"
            android:paddingLeft="20dp"
            android:spinnerMode="dropdown" />

        <!-- add list-->
        <TextView
            android:id="@+id/createListText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginRight="155dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/poppins_semibold"
            android:text="+ Create List"
            android:textColor="#4F1F7A"
            android:textSize="13sp" />

        <!-- word -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="175dp"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Word"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/wordInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/rounded"
            android:fontFamily="@font/poppins"
            android:hint="Enter word"
            android:inputType="text"
            android:paddingLeft="20dp"
            android:paddingTop="5dp"
            android:textColorHint="#959191"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- meaning -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="160dp"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Meaning"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/meaningInput"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/card"
            android:fontFamily="@font/poppins"
            android:hint="Enter Meaning"
            android:inputType="textMultiLine"
            android:overScrollMode="ifContentScrolls"
            android:padding="13dp"
            android:scrollbars="vertical"
            android:singleLine="false"
            android:textColorHint="#959191"
            android:textSize="18sp" />

        <!-- add word button -->
        <Button
            android:id="@+id/addWordBtn"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:backgroundTint="#4F1F7A"
            android:fontFamily="@font/poppins_semibold"
            android:text="Add Word"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <!--   Navigation     -->
        <ImageView
            android:id="@+id/navigationView"
            android:layout_width="389dp"
            android:layout_height="116dp"
            android:layout_gravity="center"
            android:layout_marginTop="230dp"
            app:srcCompat="@drawable/screenshot_2025_11_07_155215" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="-90dp"
            android:orientation="horizontal">

            <!-- buttons pang lipat act-->
            <Button
                android:id="@+id/homeNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:layout_marginLeft="7dp"
                android:alpha=".5"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/addWordNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:layout_marginLeft="1dp"
                android:alpha=".5"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/wordListNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:layout_marginLeft="1dp"
                android:alpha=".5"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/profileNavbtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:layout_marginLeft="1dp"
                android:alpha=".5"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false" />

        </LinearLayout>
    </LinearLayout>

    <!-- Popup for adding a new set - Placed outside main content -->
    <LinearLayout
        android:id="@+id/addWordPopUp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:background="@drawable/card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/closeAddSet"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="right"
            android:layout_marginBottom="20dp"
            app:srcCompat="@drawable/screenshot_2025_11_07_112359" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Create New Set"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/setInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/rounded"
            android:fontFamily="@font/poppins"
            android:hint="Set Name"
            android:inputType="text"
            android:paddingLeft="20dp"
            android:paddingTop="5dp"
            android:textColorHint="#959191"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/addSetBtn"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#4F1F7A"
            android:fontFamily="@font/poppins_semibold"
            android:text="Create"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</RelativeLayout>