<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    tools:context=".WordFrenzyActivity">

        <!-- In your layout XML -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="850dp"
            android:background="@drawable/wordfrenzybg"
            android:layout_marginTop="23dp">
            <!-- Your content here -->
        </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-850dp"
        android:orientation="vertical">

        <!-- Countdown Title -->
        <TextView
            android:id="@+id/tvCountdownStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="START!"
            android:textColor="@color/white"
            android:textSize="75sp"
            android:textStyle="bold"
            android:fontFamily="@font/slackey"
            android:layout_marginTop="350dp"
            android:layout_gravity="center" />

        <!-- Spacer to push nav bar to bottom -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="285dp"
            android:layout_weight="1" />

        <!-- Navigation Bar Image -->
        <ImageView
            android:id="@+id/navigationView"
            android:layout_width="389dp"
            android:layout_height="116dp"
            android:layout_gravity="center"
            android:layout_marginTop="100dp"
            app:srcCompat="@drawable/screenshot_2025_11_07_155215" />

        <!-- Navigation Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="horizontal"
            android:layout_marginTop="-90dp">

            <Button
                android:id="@+id/homeNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:layout_marginLeft="7dp"
                android:alpha=".5"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/addWordNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:layout_marginLeft="1dp"
                android:alpha=".5"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/wordListNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:layout_marginLeft="1dp"
                android:alpha=".5"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/profileNavbtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:layout_marginLeft="1dp"
                android:alpha=".5"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
