                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginRight="100sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/defText4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8sp"
                        android:fontFamily="@font/poppins"
                        android:text="Not knowing or not paying attention to something."
                        android:textColor="@android:color/black"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- 🟠 5th Box -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="1dp"> <!-- reduced spacing -->

                <ImageView
                    android:id="@+id/btnFifth"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    app:srcCompat="@drawable/boxcontainer" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/wordText5"
                        android:text="Oblivious"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginRight="100sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/defText5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5sp"
                        android:fontFamily="@font/poppins"
                        android:text="Not knowing or not paying attention to something."
                        android:textColor="@android:color/black"
                        android:textSize="14sp"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="8dp"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 🟧 Navigation Section (unchanged) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/navigationView"
            android:layout_width="389dp"
            android:layout_height="116dp"
            app:srcCompat="@drawable/screenshot_2025_11_07_155215"
            android:layout_marginTop="19dp"
            android:adjustViewBounds="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="-90dp">

            <Button
                android:id="@+id/homeNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:alpha=".5"
                android:background="@android:color/transparent"

                />

            <Button
                android:id="@+id/addWordNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:alpha=".5"
                android:background="@android:color/transparent"
                />

            <Button
                android:id="@+id/wordListNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:alpha=".5"
                android:background="@android:color/transparent"
                />

            <Button
                android:id="@+id/profileNavbtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:alpha=".5"
                android:background="@android:color/transparent"
                />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>

</LinearLayout>
