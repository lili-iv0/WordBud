<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/white"
    tools:context=".WordFrenzyActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="850dp"
        android:background="@drawable/wordfrenzybg"
        android:layout_marginTop="23dp">
        <!-- Your content here -->
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-850dp"
        android:orientation="vertical"
        >

        <!-- Empty Space -->
        <View
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="start"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"/>

        <!-- SCORE Title -->
        <TextView
            android:id="@+id/tvScoreTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCORE"
            android:textColor="@color/white"
            android:textSize="72sp"
            android:textStyle="bold"
            android:fontFamily="@font/slackey"
            android:layout_marginTop="60dp"
            android:layout_gravity="center" />

        <!-- Score Display -->
        <TextView
            android:id="@+id/tvScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 0"
            android:textColor="@color/white"
            android:textSize="64sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_semibold"
            android:layout_marginTop="40dp"
            android:layout_gravity="center" />

        <!-- Percentage Display -->
        <TextView
            android:id="@+id/tvPercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_semibold"
            android:layout_marginBottom="50dp"
            android:layout_gravity="center" />

        <!-- Buttons -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTryAgain"
            android:layout_width="295dp"
            android:layout_height="75dp"
            android:text="Try Again?"
            android:textColor="#7C0559"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="@font/slackey"
            android:background="@drawable/button_custom"
            app:backgroundTint="@null"
            android:layout_marginBottom="30dp"
            android:layout_gravity="center" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnReturnHome"
            android:layout_width="295dp"
            android:layout_height="75dp"
            android:text="Exit"
            android:textColor="#7C0559"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="@font/slackey"
            android:background="@drawable/button_custom"
            app:backgroundTint="@null"
            android:layout_gravity="center" />


        <!-- Spacer to push nav bar to bottom -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="122dp"
            android:layout_weight="1" />

        <!-- Navigation Bar Image -->
        <ImageView
            android:id="@+id/navigationView"
            android:layout_width="389dp"
            android:layout_height="116dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            app:srcCompat="@drawable/screenshot_2025_11_07_155215" />

        <!-- Navigation Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="horizontal"
            android:layout_marginTop="-90dp">

            <Button
                android:id="@+id/homeNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:layout_marginLeft="7dp"
                android:alpha=".5"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false"
                android:contentDescription="Home" />

            <Button
                android:id="@+id/addWordNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:background="@android:color/transparent"
                android:layout_marginLeft="1dp"
                android:alpha=".5"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false"
                android:contentDescription="Add Word" />

            <Button
                android:id="@+id/wordListNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:layout_marginLeft="1dp"
                android:alpha=".5"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false"
                android:contentDescription="Word List"/>

            <Button
                android:id="@+id/profileNavbtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:layout_marginLeft="1dp"
                android:alpha=".5"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false"
                android:contentDescription="Profile"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
