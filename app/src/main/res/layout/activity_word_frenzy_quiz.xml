<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/white"
    tools:context=".WordFrenzyActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="850dp"
        android:background="@drawable/wordfrenzybg"
        android:layout_marginTop="23dp">
        <!-- Your content here -->
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-850dp"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="790dp"
            android:orientation="vertical"
            android:padding="35dp">
    <!-- Logo and Countdown with Spacer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="15dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivWordFrenzyLogo"
                android:layout_width="230dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="Word Frenzy Logo"
                android:scaleType="fitCenter"
                android:src="@drawable/wordfrenzylogo" />

            <!-- Spacer to push countdown to right -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:30"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="normal"
                android:fontFamily="@font/poppins_semibold" />
        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/white"
            android:layout_marginBottom="20dp" />

        <!-- Question Number and Score -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="15dp">

            <TextView
                android:id="@+id/tvQuestionNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Question 1/10"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="normal"
                android:fontFamily="@font/poppins_semibold" />

            <TextView
                android:id="@+id/tvScoreDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Score: 0"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_semibold" />
        </LinearLayout>

        <!-- Instructions -->
        <TextView
            android:id="@+id/tvInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose the correct meaning of the word."
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="normal"
            android:fontFamily="@font/poppins"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Question Box -->
        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="130dp"
            android:text="Question will appear here"
            android:textColor="@color/black"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_extrabold"
            android:background="@drawable/button_white"
            android:padding="24dp"
            android:gravity="center"
            android:layout_marginBottom="30dp" />

        <!-- Answer Buttons -->
        <Button
            android:id="@+id/btnAnswer1"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:text="Answer 1"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="normal"
            android:fontFamily="@font/poppins"
            android:background="@drawable/button_white"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:layout_marginBottom="15dp" />

        <Button
            android:id="@+id/btnAnswer2"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:text="Answer 2"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="normal"
            android:fontFamily="@font/poppins"
            android:background="@drawable/button_white"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:layout_marginBottom="15dp" />

        <Button
            android:id="@+id/btnAnswer3"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:text="Answer 3"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="normal"
            android:fontFamily="@font/poppins"
            android:background="@drawable/button_white"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:layout_marginBottom="15dp" />

        <Button
            android:id="@+id/btnAnswer4"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:text="Answer 4"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="normal"
            android:fontFamily="@font/poppins"
            android:background="@drawable/button_white"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:layout_marginBottom="15dp" />
        </LinearLayout>

        <!-- Spacer to push nav bar to bottom -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Navigation Bar Image -->
        <ImageView
            android:id="@+id/navigationView"
            android:layout_width="389dp"
            android:layout_height="116dp"
            android:layout_gravity="center"
            android:layout_marginTop="50dp"
            app:srcCompat="@drawable/screenshot_2025_11_07_155215" />

        <!-- Navigation Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="horizontal"
            android:layout_marginTop="-90dp">

            <Button
                android:id="@+id/homeNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:layout_marginLeft="7dp"
                android:alpha=".5"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/addWordNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:background="@android:color/transparent"
                android:layout_marginLeft="1dp"
                android:alpha=".5"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/wordListNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:layout_marginLeft="1dp"
                android:alpha=".5"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/profileNavbtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:layout_marginLeft="1dp"
                android:alpha=".5"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
