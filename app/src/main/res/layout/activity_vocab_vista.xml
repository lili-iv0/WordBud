<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/white"
    android:padding="24dp"
    tools:context=".VocabVistaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="850dp"
        android:background="@drawable/vocabbg"
        android:layout_marginTop="23dp">
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop= "-850dp"
        android:orientation="vertical">


    <!-- 🟩 Main Card Area (non-scrollable) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp"
        android:elevation="8dp"
        android:layout_marginTop="220dp"
        android:layout_marginBottom="12dp"
        android:clipToOutline="true">

        <!-- 🟠 Category Image Buttons -->
        <ImageView
            android:id="@+id/btnActions"
            android:layout_width="280dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true"
            app:srcCompat="@drawable/bt_actions" />

        <ImageView
            android:id="@+id/btnAdjective"
            android:layout_width="280dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true"
            app:srcCompat="@drawable/bt_adjectives" />

        <ImageView
            android:id="@+id/btnThings"
            android:layout_width="280dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true"
            app:srcCompat="@drawable/bt_things" />

        <ImageView
            android:id="@+id/btnTechnology"
            android:layout_width="280dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true"
            app:srcCompat="@drawable/bt_technology" />

        <ImageView
            android:id="@+id/btnExpressions"
            android:layout_width="280dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:clickable="true"
            android:focusable="true"
            app:srcCompat="@drawable/bt_expressions" />
    </LinearLayout>

    <!-- 🟧 Navigation Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/navigationView"
            android:layout_width="389dp"
            android:layout_height="116dp"
            app:srcCompat="@drawable/screenshot_2025_11_07_155215"
            android:layout_marginTop="12dp"
            android:adjustViewBounds="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginLeft="-4dp"
            android:layout_marginTop="-88dp">

            <Button
                android:id="@+id/homeNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:layout_marginLeft="7dp"
                android:alpha=".5"
                android:background="@android:color/transparent"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/addWordNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:layout_marginLeft="1dp"
                android:alpha=".5"
                android:background="@android:color/transparent"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/wordListNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:layout_marginLeft="1dp"
                android:alpha=".5"
                android:background="@android:color/transparent"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/profileNavbtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:layout_marginLeft="1dp"
                android:alpha=".5"
                android:background="@android:color/transparent"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>
</LinearLayout>


