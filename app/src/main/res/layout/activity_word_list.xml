<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddWordActivity"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginTop="25dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/imageView7"
                android:layout_width="36dp"
                android:layout_height="47dp"
                android:layout_marginLeft="-2dp"
                app:srcCompat="@drawable/screenshot_2025_11_07_140118" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Word List"
                android:textSize="25sp"
                android:fontFamily="@font/poppins_extrabold"
                android:layout_marginLeft="75dp"
                android:layout_marginBottom="17dp"
                android:layout_marginTop="4dp"
                android:textColor="#4F1F7A" />
        </LinearLayout>

        <!-- Select Set -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Set"
            android:textSize="18sp"
            android:fontFamily="@font/poppins_semibold"
            android:layout_marginRight="155dp"
            android:layout_marginBottom="5dp" />

        <Spinner
            android:id="@+id/listDropdown"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/rounded"
            android:paddingLeft="20dp"
            android:spinnerMode="dropdown"
            android:layout_marginBottom="20dp" />


        <!-- Scrollable Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="520dp"
            android:layout_marginBottom="0dp">

            <LinearLayout
                android:id="@+id/wordListView"
                android:layout_width="match_parent"
                android:layout_height="520dp"
                android:orientation="vertical"
                android:background="@android:color/transparent">

                <!--   ditu malalagay mga added words     -->

            </LinearLayout>
        </ScrollView>


        <!-- Navigation Image -->
        <ImageView
            android:id="@+id/navigationView"
            android:layout_width="389dp"
            android:layout_height="116dp"
            android:layout_gravity="center"
            android:layout_marginTop="130dp"
            app:srcCompat="@drawable/screenshot_2025_11_07_155215" />

        <!-- buttons pang lipat act-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="horizontal"
            android:layout_marginTop="-90dp">

            <Button
                android:id="@+id/homeNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false"
                android:layout_marginLeft="7dp"
                android:alpha=".5" />

            <Button
                android:id="@+id/addWordNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false"
                android:layout_marginLeft="1dp"
                android:alpha=".5" />

            <Button
                android:id="@+id/wordListNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false"
                android:layout_marginLeft="1dp"
                android:alpha=".5" />

            <Button
                android:id="@+id/profileNavbtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false"
                android:layout_marginLeft="1dp"
                android:alpha=".5" />
        </LinearLayout>

        <!-- Popup para sa edit sana kaso hirap -->
        <LinearLayout
            android:id="@+id/addWordPopUp"
            android:layout_width="match_parent"
            android:layout_height="500dp"
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_marginTop="-700dp"
            android:background="@drawable/card"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:id="@+id/closeAddSet"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginBottom="20dp"
                android:layout_marginRight="17dp"
                android:layout_gravity="right"
                app:srcCompat="@drawable/screenshot_2025_11_07_112359" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Word"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_semibold"
                android:layout_marginRight="150dp"
                android:layout_marginBottom="5dp" />

            <EditText
                android:id="@+id/wordInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:inputType="text"
                android:layout_marginBottom="15dp"
                android:paddingTop="5dp"
                android:paddingLeft="20dp"
                android:fontFamily="@font/poppins"
                android:background="@drawable/rounded"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColorHint="#959191"
                android:hint="Enter word" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meaning"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_semibold"
                android:layout_marginRight="135dp"
                android:layout_marginBottom="5dp" />

            <EditText
                android:id="@+id/meaningInput"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginBottom="15dp"
                android:fontFamily="@font/poppins"
                android:background="@drawable/card"
                android:textSize="18sp"
                android:padding="13dp"
                android:hint="Enter Meaning"
                android:textColorHint="#959191"
                android:inputType="textMultiLine"
                android:singleLine="false"
                android:scrollbars="vertical"
                android:overScrollMode="ifContentScrolls" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:orientation="horizontal"
                android:gravity="right"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:id="@+id/deleteBtn"
                    android:layout_width="45dp"
                    android:layout_height="47dp"
                    android:layout_gravity="right"
                    android:layout_marginRight="17dp"
                    android:layout_marginBottom="20dp"
                    app:srcCompat="@drawable/screenshot_2025_11_07_220159" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>