<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:background="@android:color/transparent">

    <!-- Center modal background -->
    <FrameLayout
        android:id="@+id/modalContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">

        <!-- Modal background image -->
        <ImageView
            android:id="@+id/modalBg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/modal_bg"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

        <!-- Spinner (top area) -->
        <Spinner
            android:id="@+id/spinnerWordList"
            android:layout_width="170dp"
            android:layout_height="20dp"
            android:layout_marginTop="20dp"
            android:layout_gravity="center_horizontal"
            android:background="@android:color/transparent"
            android:popupBackground="@android:color/white"
            android:spinnerMode="dropdown" />

        <!-- Word box (overlay aligned to image) -->
        <EditText
            android:id="@+id/txtWord"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_marginTop="55dp"
            android:layout_gravity="center_horizontal"
            android:background="@android:color/transparent"
            android:focusable="false"
            android:clickable="false"
            android:textColor="@android:color/black"
            android:gravity="center"
            android:textSize="16sp" />

        <!-- Definition box -->
        <EditText
            android:id="@+id/txtDefinition"
            android:layout_width="220dp"
            android:layout_height="110dp"
            android:layout_marginTop="130dp"
            android:layout_gravity="center_horizontal"
            android:background="@android:color/transparent"
            android:focusable="false"
            android:clickable="false"
            android:textColor="@android:color/black"
            android:gravity="top|start"
            android:padding="8dp"
            android:textSize="15sp" />

        <!-- Add Word button -->
        <Button
            android:id="@+id/btnAddWord"
            android:layout_width="270dp"
            android:layout_height="48dp"
            android:layout_marginTop="260dp"
            android:layout_gravity="center_horizontal"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@android:color/transparent" />

        <!-- Exit (X) button in top right corner -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:layout_gravity="end"
            android:background="@android:color/transparent"
            android:contentDescription="Close" />
    </FrameLayout>

</RelativeLayout>
