<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#4F1F7A"
    android:gravity="center"
    android:padding="24dp"
    tools:context=".UsernameActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:layout_marginTop="230dp"
        android:fontFamily="@font/poppins"
        android:text="Before we learn new words,"
        android:textColor="@color/white"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:textColor="@color/white"
        android:fontFamily="@font/poppins"
        android:textSize="20sp"
        android:text="tell me yours!" />

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="391dp"
        android:layout_height="607dp"
        android:layout_marginTop="-50dp"
        app:srcCompat="@drawable/screenshot_2025_11_06_175812" />

    <EditText
        android:id="@+id/username"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:inputType="text"
        android:layout_marginTop="-260dp"
        android:fontFamily="@font/poppins"
        android:background="@drawable/rounded"
        android:hint="Username"
        android:gravity="center"
        android:paddingTop="10dp"
        android:textSize="18sp" />

    <ImageView
        android:layout_width="97dp"
        android:layout_height="121dp"
        android:layout_marginLeft="-115dp"
        android:layout_marginTop="-126dp"
        app:srcCompat="@drawable/hands" />

    <ImageView
        android:layout_width="97dp"
        android:layout_height="121dp"
        android:layout_marginRight="-115dp"
        android:layout_marginTop="-123dp"
        app:srcCompat="@drawable/hands" />

    <Button
        android:id="@+id/usernameBtn"
        android:layout_width="159dp"
        android:layout_height="56dp"
        android:layout_marginTop="190dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="@color/white"
        android:fontFamily="@font/poppins_semibold"
        android:padding="12dp"
        android:text="Begin"
        android:textAllCaps="false"
        android:textColor="#4F1F7A"
        android:textSize="18sp" />

</LinearLayout>
