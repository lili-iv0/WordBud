<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:padding="24dp"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MindFlipActivity">



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="850dp"
        android:background="@drawable/mindflipbg"
        android:layout_marginTop="25dp">
    </LinearLayout>

    <!-- Main Content (fixed layout) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        >

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@android:color/white"
            android:rotation="-7"
            android:layout_marginTop="40dp"
            android:layout_gravity="center" />

        <!-- Flashcard -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWord"
            android:layout_width="320dp"
            android:layout_height="270dp"
            android:layout_marginTop="255dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#B3FFFFFF"
            app:strokeColor="@android:color/white"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tvWord"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Word"
                android:background="@drawable/flip"
                android:textColor="#333"
                android:textSize="22sp"
                android:fontFamily="@font/poppins" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Buttons -->
        <LinearLayout
            android:id="@+id/layoutButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="30dp"
            android:gravity="center">

            <Button
                android:id="@+id/btnPrev"
                android:layout_width="90dp"
                android:layout_height="45dp"
                android:textColor="@android:color/white"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnFlip"
                android:layout_width="90dp"
                android:layout_height="45dp"
                android:layout_marginHorizontal="12dp"
                android:textColor="@android:color/white"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="90dp"
                android:layout_height="45dp"
                android:textColor="@android:color/white"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- Movable Spinner + Card Count -->
    <RelativeLayout
        android:id="@+id/topControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="73dp">

        <Spinner
            android:id="@+id/spinnerSets"
            android:layout_width="180dp"
            android:layout_height="40dp"
            android:layout_marginTop="205dp"
            android:background="@android:color/transparent"
            android:spinnerMode="dropdown" />

        <TextView
            android:id="@+id/tvCardCount"
            android:layout_width="60dp"
            android:layout_height="40dp"
            android:layout_marginStart="217dp"
            android:layout_marginTop="207dp"
            android:gravity="center"
            android:text="1/20"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:fontFamily="@font/poppins" />
    </RelativeLayout>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="vertical"
        android:layout_alignParentBottom="true">

        <ImageView
            android:id="@+id/navigationView"
            android:layout_width="389dp"
            android:layout_height="116dp"
            android:layout_gravity="center"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="15dp"
            app:srcCompat="@drawable/screenshot_2025_11_07_155215" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="horizontal"
            android:layout_marginTop="-110dp">

            <Button
                android:id="@+id/homeNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false"
                android:background="@android:color/transparent"
                android:layout_marginLeft="7dp"
                android:alpha=".5" />

            <Button
                android:id="@+id/addWordNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false"
                android:layout_marginLeft="1dp"
                android:alpha=".5" />

            <Button
                android:id="@+id/wordListNavBtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false"
                android:layout_marginLeft="1dp"
                android:alpha=".5" />

            <Button
                android:id="@+id/profileNavbtn"
                android:layout_width="95dp"
                android:layout_height="65dp"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_semibold"
                android:textAllCaps="false"
                android:layout_marginLeft="1dp"
                android:alpha=".5" />
        </LinearLayout>
    </LinearLayout>

    </RelativeLayout>